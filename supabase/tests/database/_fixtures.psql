-- Shared fixture for the pgTAP suite. Each *.test.sql file loads it with \ir
-- inside its own transaction and rolls back at the end, so nothing persists.
-- (The .psql extension keeps pg_prove from running it as a test.)
--
--   Gym A: owner_a, head_a, coach_a, viewer_a       Gym B: owner_b, coach_b
--   outsider: signed in, member of no gym
--
--   Core library: core_squat (squat 1.0), core_wallball (squat 0.6 / v_push 0.4),
--                 core_row (monostructural, no patterns)
--   Gym exercises: ex_a (gym A), ex_b (gym B), both hinge 1.0
--   Equipment: kettlebell (from the seeded list) on core_squat, ex_a and ex_b
--   The seeded core library (Step 2) is present too; fixture rows are separate.
--   Aliases: alias_core (core), alias_a (gym A), alias_b (gym B)
--   workout_a: draft, block_a with item_a_matched + item_a_unmatched
--   workout_b: published, block_b with item_b

create schema tests;
grant usage on schema tests to anon, authenticated;

create table tests.ids (name text primary key, id uuid not null default gen_random_uuid());
grant select on tests.ids to anon, authenticated;

insert into tests.ids (name)
select unnest(array[
  'owner_a', 'head_a', 'coach_a', 'viewer_a', 'owner_b', 'coach_b', 'outsider',
  'gym_a', 'gym_b', 'track_a', 'track_b',
  'core_squat', 'core_wallball', 'core_row', 'ex_a', 'ex_b',
  'alias_core', 'alias_a', 'alias_b',
  'workout_a', 'block_a', 'item_a_matched', 'item_a_unmatched',
  'workout_b', 'block_b', 'item_b'
]);

-- Fixture id by name.
create function tests.id(p_name text)
returns uuid
language sql stable
as $$ select id from tests.ids where name = p_name $$;

-- Act as a signed-in fixture user (as the Data API would) until the next switch.
create function tests.login_as(p_name text)
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims',
    json_build_object('sub', tests.id(p_name), 'role', 'authenticated')::text, true);
end;
$$;

-- Act as a visitor who is not signed in.
create function tests.login_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role": "anon"}', true);
end;
$$;

-- Back to the test runner's own role (bypasses RLS, used to set up and verify).
create function tests.logout()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- Users (profiles are created by the signup trigger)
insert into auth.users (id, email, raw_user_meta_data)
select tests.id(n), n || '@example.test', jsonb_build_object('display_name', n)
from unnest(array['owner_a', 'head_a', 'coach_a', 'viewer_a', 'owner_b', 'coach_b', 'outsider']) as n;

-- Gyms and members
insert into public.organizations (id, name, slug, country) values
  (tests.id('gym_a'), 'Gym A', 'gym-a', 'IS'),
  (tests.id('gym_b'), 'Gym B', 'gym-b', 'IS');

insert into public.memberships (org_id, user_id, role) values
  (tests.id('gym_a'), tests.id('owner_a'),  'owner'),
  (tests.id('gym_a'), tests.id('head_a'),   'head_coach'),
  (tests.id('gym_a'), tests.id('coach_a'),  'coach'),
  (tests.id('gym_a'), tests.id('viewer_a'), 'viewer'),
  (tests.id('gym_b'), tests.id('owner_b'),  'owner'),
  (tests.id('gym_b'), tests.id('coach_b'),  'coach');

insert into public.tracks (id, org_id, name, color) values
  (tests.id('track_a'), tests.id('gym_a'), 'Class', '#2563EB'),
  (tests.id('track_b'), tests.id('gym_b'), 'Class', '#16A34A');

