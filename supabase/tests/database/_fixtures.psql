insert into public.exercises (id, org_id, name, slug, kind, plane, default_unit) values
  (tests.id('core_squat'),    null,             'Fixture back squat', 'fixture-back-squat', 'movement', 'sagittal', 'reps'),
  (tests.id('core_wallball'), null,             'Fixture wall ball',  'fixture-wall-ball',  'movement', 'sagittal', 'reps'),
  (tests.id('ex_a'),          tests.id('gym_a'), 'Gym A sandbag clean', 'sandbag-clean',    'movement', null,       'reps'),
  (tests.id('ex_b'),          tests.id('gym_b'), 'Gym B sandbag clean', 'sandbag-clean',    'movement', null,       'reps');

insert into public.exercises (id, org_id, name, slug, kind, modality, default_unit) values
  (tests.id('core_row'), null, 'Fixture row', 'fixture-row', 'monostructural', 'row', 'distance_m');

insert into public.exercise_equipment (exercise_id, equipment_key) values
  (tests.id('core_squat'), 'kettlebell'),
  (tests.id('ex_a'),       'kettlebell'),
  (tests.id('ex_b'),       'kettlebell');

insert into public.exercise_patterns (exercise_id, pattern_key, weight) values
  (tests.id('core_squat'),    'squat',  1.00),
  (tests.id('core_wallball'), 'squat',  0.60),
  (tests.id('core_wallball'), 'v_push', 0.40),
  (tests.id('ex_a'),          'hinge',  1.00),
  (tests.id('ex_b'),          'hinge',  1.00);

insert into public.exercise_muscles (exercise_id, muscle_key, role) values
  (tests.id('core_squat'), 'quads',  'primary'),
  (tests.id('core_squat'), 'glutes', 'primary'),
  (tests.id('ex_a'),       'glutes', 'primary'),
  (tests.id('ex_b'),       'glutes', 'primary');

insert into public.exercise_aliases (id, org_id, alias_normalized, exercise_id) values
  (tests.id('alias_core'), null,              'fixture squat', tests.id('core_squat')),
  (tests.id('alias_a'),    tests.id('gym_a'), 'bs',            tests.id('core_squat')),
  (tests.id('alias_b'),    tests.id('gym_b'), 'sbc',           tests.id('ex_b'));

-- Workouts
insert into public.workouts (id, org_id, track_id, kind, date, title, raw_text) values
  (tests.id('workout_a'), tests.id('gym_a'), tests.id('track_a'), 'scheduled', '2026-10-20', 'A day', 'A. 5 x 5 back squat @75-80%'),
  (tests.id('workout_b'), tests.id('gym_b'), tests.id('track_b'), 'scheduled', '2026-10-20', 'B day', 'A. 5 x 5 sandbag clean');

insert into public.blocks (id, workout_id, org_id, position, label, intent, format, params, load_effort) values
  (tests.id('block_a'), tests.id('workout_a'), tests.id('gym_a'), 0, 'A', 'strength', 'sets', '{"sets": 5, "rest_s": 120}', 'hard'),
  (tests.id('block_b'), tests.id('workout_b'), tests.id('gym_b'), 0, 'A', 'strength', 'sets', '{"sets": 5}', 'hard');

insert into public.block_items (id, block_id, org_id, position, exercise_id, raw_line, quantity, load) values
  (tests.id('item_a_matched'),   tests.id('block_a'), tests.id('gym_a'), 0, tests.id('core_squat'), '5 back squat @75-80%',
   '{"type": "reps", "value": 5}', '{"type": "percent_1rm", "min": 75, "max": 80}'),
  (tests.id('item_a_unmatched'), tests.id('block_a'), tests.id('gym_a'), 1, null, '8/8 mystery lunge',
   '{"type": "reps_per_side", "value": 8}', null),
  (tests.id('item_b'),           tests.id('block_b'), tests.id('gym_b'), 0, tests.id('ex_b'), '5 sandbag clean',
   '{"type": "reps", "value": 5}', null);

update public.workouts set status = 'published' where id = tests.id('workout_b');

insert into public.workout_metrics (workout_id, org_id, calc_version, taxonomy_version, metrics) values
  (tests.id('workout_a'), tests.id('gym_a'), 1, 1, '{}'),
  (tests.id('workout_b'), tests.id('gym_b'), 1, 1, '{}');
